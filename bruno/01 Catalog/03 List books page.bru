meta {
  name: List books page
  type: http
  seq: 3
}

get {
  url: {{api_url}}/books?page={{page}}&page_size={{page_size}}
  body: none
  auth: none
}

tests {
  test("Books are paginated", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().books.length).to.be.at.most(Number(bru.getEnvVar("page_size")));
  });
}

docs {
  Uses the local recovery service. Start start-recovery.sh and select the Local environment.
}
