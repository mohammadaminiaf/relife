meta {
  name: Remote metadata by ID
  type: http
  seq: 2
}

get {
  url: {{site_url}}/api/book_meta_info.php?desc=1&id={{book_id}}
  body: none
  auth: none
}

script:post-response {
  const body = res.getBody();
  const book = typeof body === "string" ? JSON.parse(body) : body;
  if (String(book.id) !== String(bru.getEnvVar("book_id"))) throw new Error("Unexpected book ID");
  bru.setEnvVar("book_filename", book.ghm_file_name);
  bru.setEnvVar("filename_book_id", String(book.id));
}

docs {
  Calls the recovered upstream API directly. Save binary responses manually; use Downloads for verified on-disk recovery.
}
